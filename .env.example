# URL of your permanent Google Apps Script /exec deployment that returns the wallpaper JSON feed.
# This is baked into the static build at build time — set it in Netlify's
# Site settings -> Environment variables before deploying (or in a local .env
# file for `npm run dev` / `npm run build`).
VITE_WOWPAPERS_FEED_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
